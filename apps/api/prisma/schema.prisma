generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  watchlists Watchlist[]
  settings  UserSetting?
}

model Watchlist {
  id        String   @id @default(cuid())
  name      String
  type      String
  symbols   String[]
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model StrategyConfig {
  id          String   @id @default(cuid())
  name        String
  style       String
  enabled     Boolean  @default(true)
  weightJson  Json
  thresholdJson Json
  createdAt   DateTime @default(now())
}

model AiAnalysisHistory {
  id         String   @id @default(cuid())
  symbol     String
  task       String
  request    Json
  response   Json
  createdAt  DateTime @default(now())
}

model SignalHistory {
  id         String   @id @default(cuid())
  symbol     String
  payload    Json
  createdAt  DateTime @default(now())
}

model BacktestJob {
  id          String   @id @default(cuid())
  symbol      String
  strategyId  String
  params      Json
  status      String
  result      Json?
  createdAt   DateTime @default(now())
}

model SentimentSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  score     Float
  label     String
  source    String
  createdAt DateTime @default(now())
}

model UserSetting {
  id          String @id @default(cuid())
  userId      String @unique
  config      Json
  user        User   @relation(fields: [userId], references: [id])
}

model AuditRecord {
  id          String   @id @default(cuid())
  actor       String
  action      String
  targetType  String
  targetId    String
  payload     Json
  createdAt   DateTime @default(now())
}
